# Токен Telegram-бота из @BotFather
BOT_TOKEN=123456789:ABC-DEF...

# Ключ Anthropic (тот же что для основного бота можно использовать)
ANTHROPIC_API_KEY=sk-ant-...

# Модель Claude (можно поменять на opus для большей точности, дороже)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Дешёвая модель для авто-обучения фактам в фоне
LEARN_MODEL=claude-haiku-4-5-20251001

# Путь к БД. На Railway с Volume — /data/mariya_data.db. Без Volume — mariya_data.db
DB_PATH=/data/mariya_data.db

# Где лежит JSON с меню (категории, подкатегории и все рецепты).
# Это новое имя — раньше было RECIPES_PATH=recipes.json.
# Если в Railway ещё стоит старая RECIPES_PATH — поменяй её на MENU_PATH=menu.json
MENU_PATH=menu.json

# Prodamus
PRODAMUS_SECRET_KEY=секретный_ключ_из_личного_кабинета
PRODAMUS_SHOP_URL=https://example.payform.ru/
PRODAMUS_DEMO_MODE=0

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","...":"..."}
GOOGLE_SHEET_ID=id_таблицы

# Администратор и безопасные боевые значения тестовых режимов
ADMIN_USER_ID=123456789
# Несколько Telegram ID администраторов через запятую.
# Если переменная не задана, используется ADMIN_USER_ID для обратной совместимости.
ADMIN_USER_IDS=123456789,987654321
FUNNEL_TEST_MODE=0
RENEWAL_TEST_INTERVAL_SEC=0
TESTPAY_OPEN=0
