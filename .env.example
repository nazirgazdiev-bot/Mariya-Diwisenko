# Токен ОТДЕЛЬНОГО тестового Telegram-бота (для режима telegram_bot.py)
# Создай нового бота в @BotFather специально для тестирования МарИИи
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF...

# Ключ Anthropic (тот же что для основного бота можно использовать)
ANTHROPIC_API_KEY=sk-ant-...

# Секрет для авторизации запросов от Salebot — придумай длинную случайную строку
API_SECRET=придумай_длинный_секрет_который_знаешь_только_ты_и_salebot

# Модель Claude (можно поменять на opus для большей точности, дороже)
CLAUDE_MODEL=claude-sonnet-4-6

# Дешёвая модель для авто-обучения фактам в фоне
LEARN_MODEL=claude-haiku-4-5-20251001

# Путь к БД. На Railway с Volume — /data/mariya_data.db. Без Volume — mariya_data.db
DB_PATH=/data/mariya_data.db

# Где лежит JSON с меню (категории, подкатегории и все рецепты).
# Это новое имя — раньше было RECIPES_PATH=recipes.json.
# Если в Railway ещё стоит старая RECIPES_PATH — поменяй её на MENU_PATH=menu.json
MENU_PATH=menu.json
